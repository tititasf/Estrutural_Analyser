# Large DXF/DWG files from client projects (>80MB - exceeds GitHub limits)
**/Projetos_Finalizados_para_Engenharia_Reversa/*.dxf
**/Projetos_Finalizados_para_Engenharia_Reversa/*.dwg

# Large binary release artifacts
repository/targets/

# Large binary data files (DB principal + backups/WAL/SHM, >1GB)
# DBs/vision ficam no DVC — nao versionar no git
project_data.vision
project_data.vision-wal
project_data.vision-shm
project_data.vision.bak*
engrev_*.vision
engrev_*.vision.bak*
*.vision
*.vision-wal
*.vision-shm
*.db
*.sqlite
*.sqlite3
*.bak

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.pytest_cache/
.pytest-tmp/
.fuse_hidden*

# Runtime lock files (single-instance, headless, etc.) — never commit
*.lock

# Logs locais efemeros
ce_debug.log
public_audit.log

# Build/dist artifacts (todos ROBOS_ABAS - executaveis e compactados >80MB)
_ROBOS_ABAS/**/build/
_ROBOS_ABAS/**/dist/
_ROBOS_ABAS/**/Distribuicao*/
_ROBOS_ABAS/**/*.rar
_ROBOS_ABAS/**/*.zip
_ROBOS_ABAS/**/*.exe
_ROBOS_ABAS/**/*.pkg
/DADOS-OBRAS

# ByteRover local memory, sessions and embedded context-tree repository
**/.brv/
