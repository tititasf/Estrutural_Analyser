{
  "schema": "arete.qa_class_profile/v1",
  "class": "LV",
  "version": "1.4.1",
  "authority": "validation_ready via LvEvidenceAuditor; A/B and PARA/PASSA remain four independent contracts; see data/authority_matrix.json",
  "model": "Lateral de viga possui dois lados e dois comportamentos. A_PARA, B_PARA, A_PASSA e B_PASSA têm seleção, ajustes, painéis e prova independentes. O corte é contexto comum, não licença para espelhar dados.",
  "manual_guides": [
    "docs/LV-COMPREENDER-INTERPRETACAO-FICHAS-N2-N4.md",
    "docs/MASTERPLAN-ARETE-LATERAL-VIGA.md",
    "scripts/arete/html_fichas/Obra_TREINO_1/TMC-EST-PE-6000-13P-R03_R2018_ASCII_ODA_20260706_103941/laterais_viga/interpretacao_laterais.html",
    "src/ui/widgets/preficha_lateral_html.py",
    "src/core/lv_generation_contract.py"
  ],
  "protected_guides": ["interpretacao_laterais.html"],
  "n1": {
    "table": "beams",
    "payload": "data_json",
    "families": {
      "identity": ["fields.nome", "fields.dimensao", "lv_interpreter_contract_version"],
      "segments_A": ["viga_a_seg_N_*", "links.viga_a_seg_N_*"],
      "segments_B": ["viga_b_seg_N_*", "links.viga_b_seg_N_*"],
      "behaviors": ["lv_generation_contracts.Para.A/B", "lv_generation_contracts.Passa.A/B"],
      "exceptions": ["abert_pilar_esq/dir", "endpoint_events", "lajes", "pontaletes", "grades"]
    },
    "probes": {
      "four_contracts_and_support": {
        "question": "{item} mantém A/B × PARA/PASSA com origem por segmento, isolamento explícito e um apoio extremo local rastreável?",
        "fields": [
          {"id": "lv.name", "class": "LV", "item": "{item}", "source": "payload", "path": "fields.nome", "transform": "entity"},
          {"id": "lv.dim", "class": "LV", "item": "{item}", "source": "payload", "path": "fields.dimensao", "transform": "dimension"},
          {"id": "lv.a.dim", "class": "LV", "item": "{item}", "source": "payload", "path": "fields.viga_a_seg_1_dim", "transform": "dimension"},
          {"id": "lv.b.dim", "class": "LV", "item": "{item}", "source": "payload", "path": "fields.viga_b_seg_1_dim", "transform": "dimension"},
          {"id": "lv.support.name", "class": "LV", "item": "{item}", "source": "payload", "path": "fields.viga_a_seg_1_end_name", "transform": "entity"},
          {"id": "lv.para.a.id", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.contract_id", "transform": "text"},
          {"id": "lv.para.b.id", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.contract_id", "transform": "text"},
          {"id": "lv.passa.a.id", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.contract_id", "transform": "text"},
          {"id": "lv.passa.b.id", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.contract_id", "transform": "text"},
          {"id": "lv.para.a.side", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.side", "transform": "text"},
          {"id": "lv.para.b.side", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.side", "transform": "text"},
          {"id": "lv.passa.a.side", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.side", "transform": "text"},
          {"id": "lv.passa.b.side", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.side", "transform": "text"},
          {"id": "lv.para.a.behavior", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.behavior", "transform": "text"},
          {"id": "lv.para.b.behavior", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.behavior", "transform": "text"},
          {"id": "lv.passa.a.behavior", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.behavior", "transform": "text"},
          {"id": "lv.passa.b.behavior", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.behavior", "transform": "text"},
          {"id": "lv.para.a.ready", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.generation_ready", "transform": "raw"},
          {"id": "lv.para.b.ready", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.generation_ready", "transform": "raw"},
          {"id": "lv.passa.a.ready", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.generation_ready", "transform": "raw"},
          {"id": "lv.passa.b.ready", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.generation_ready", "transform": "raw"},
          {"id": "lv.para.a.source_keys", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.structural_segments.*.source_key", "transform": "flatten"},
          {"id": "lv.para.b.source_keys", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.structural_segments.*.source_key", "transform": "flatten"},
          {"id": "lv.passa.a.source_keys", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.structural_segments.*.source_key", "transform": "flatten"},
          {"id": "lv.passa.b.source_keys", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.structural_segments.*.source_key", "transform": "flatten"},
          {"id": "lv.para.a.source_slots", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.structural_segments.*.source_slot", "transform": "flatten"},
          {"id": "lv.para.b.source_slots", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B.structural_segments.*.source_slot", "transform": "flatten"},
          {"id": "lv.passa.a.source_slots", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A.structural_segments.*.source_slot", "transform": "flatten"},
          {"id": "lv.passa.b.source_slots", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B.structural_segments.*.source_slot", "transform": "flatten"},
          {"id": "lv.para.a.isolated", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A._sa_meta.behavior_isolated", "transform": "raw"},
          {"id": "lv.para.b.isolated", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B._sa_meta.behavior_isolated", "transform": "raw"},
          {"id": "lv.passa.a.isolated", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A._sa_meta.behavior_isolated", "transform": "raw"},
          {"id": "lv.passa.b.isolated", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B._sa_meta.behavior_isolated", "transform": "raw"},
          {"id": "lv.para.a.fv_fallback", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A._sa_meta.fv_dimension_fallback", "transform": "raw"},
          {"id": "lv.para.b.fv_fallback", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.B._sa_meta.fv_dimension_fallback", "transform": "raw"},
          {"id": "lv.passa.a.fv_fallback", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.A._sa_meta.fv_dimension_fallback", "transform": "raw"},
          {"id": "lv.passa.b.fv_fallback", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Passa.B._sa_meta.fv_dimension_fallback", "transform": "raw"},
          {"id": "lv.para.a.bbox", "class": "LV", "item": "{item}", "source": "payload", "path": "lv_generation_contracts.Para.A.structural_segments.0.points", "transform": "bbox"},
          {"id": "support.name", "class_from": "lv.support.name", "item_from": "lv.support.name", "source": "column", "path": "name", "transform": "entity"},
          {"id": "support.bbox", "class_from": "lv.support.name", "item_from": "lv.support.name", "source": "geometry", "path": "geometry.classified.seg_bottom", "source_by_class": {"PIL": "geometry", "LV": "geometry"}, "path_by_class": {"PIL": "", "LV": "geometry.classified.seg_bottom"}, "transform": "bbox"}
        ],
        "checks": [
          {"id": "beam_identity", "op": "same_entity", "left": "lv.name", "value": "{item}"},
          {"id": "dim_A", "op": "present", "left": "lv.a.dim", "reason": "dimensão própria do lado A presente; não espelhar nem confundir com a seção global"},
          {"id": "dim_B", "op": "present", "left": "lv.b.dim", "reason": "dimensão própria do lado B presente; não espelhar nem confundir com a seção global"},
          {"id": "contract_A_PARA", "op": "equal", "left": "lv.para.a.id", "value": "LV_A_PARA"},
          {"id": "contract_B_PARA", "op": "equal", "left": "lv.para.b.id", "value": "LV_B_PARA"},
          {"id": "contract_A_PASSA", "op": "equal", "left": "lv.passa.a.id", "value": "LV_A_PASSA"},
          {"id": "contract_B_PASSA", "op": "equal", "left": "lv.passa.b.id", "value": "LV_B_PASSA"},
          {"id": "side_A_PARA", "op": "equal", "left": "lv.para.a.side", "value": "A"},
          {"id": "side_B_PARA", "op": "equal", "left": "lv.para.b.side", "value": "B"},
          {"id": "side_A_PASSA", "op": "equal", "left": "lv.passa.a.side", "value": "A"},
          {"id": "side_B_PASSA", "op": "equal", "left": "lv.passa.b.side", "value": "B"},
          {"id": "behavior_A_PARA", "op": "equal", "left": "lv.para.a.behavior", "value": "PARA"},
          {"id": "behavior_B_PARA", "op": "equal", "left": "lv.para.b.behavior", "value": "PARA"},
          {"id": "behavior_A_PASSA", "op": "equal", "left": "lv.passa.a.behavior", "value": "PASSA"},
          {"id": "behavior_B_PASSA", "op": "equal", "left": "lv.passa.b.behavior", "value": "PASSA"},
          {"id": "ready_A_PARA", "op": "equal", "left": "lv.para.a.ready", "value": true},
          {"id": "ready_B_PARA", "op": "equal", "left": "lv.para.b.ready", "value": true},
          {"id": "ready_A_PASSA", "op": "equal", "left": "lv.passa.a.ready", "value": true},
          {"id": "ready_B_PASSA", "op": "equal", "left": "lv.passa.b.ready", "value": true},
          {"id": "source_A_PARA", "op": "all_match", "left": "lv.para.a.source_keys", "value": "^viga_a_seg_[0-9]+_comprimento_total$"},
          {"id": "source_B_PARA", "op": "all_match", "left": "lv.para.b.source_keys", "value": "^viga_b_seg_[0-9]+_comprimento_total$"},
          {"id": "source_A_PASSA", "op": "all_match", "left": "lv.passa.a.source_keys", "value": "^viga_a_seg_[0-9]+_comp_total_passa$"},
          {"id": "source_B_PASSA", "op": "all_match", "left": "lv.passa.b.source_keys", "value": "^viga_b_seg_[0-9]+_comp_total_passa$"},
          {"id": "slot_A_PARA", "op": "all_equal", "left": "lv.para.a.source_slots", "value": "seg_side_a"},
          {"id": "slot_B_PARA", "op": "all_equal", "left": "lv.para.b.source_slots", "value": "seg_side_b"},
          {"id": "slot_A_PASSA", "op": "all_equal", "left": "lv.passa.a.source_slots", "value": "seg_side_a"},
          {"id": "slot_B_PASSA", "op": "all_equal", "left": "lv.passa.b.source_slots", "value": "seg_side_b"},
          {"id": "isolated_A_PARA", "op": "equal", "left": "lv.para.a.isolated", "value": true},
          {"id": "isolated_B_PARA", "op": "equal", "left": "lv.para.b.isolated", "value": true},
          {"id": "isolated_A_PASSA", "op": "equal", "left": "lv.passa.a.isolated", "value": true},
          {"id": "isolated_B_PASSA", "op": "equal", "left": "lv.passa.b.isolated", "value": true},
          {"id": "no_fv_fallback_A_PARA", "op": "equal", "left": "lv.para.a.fv_fallback", "value": false},
          {"id": "no_fv_fallback_B_PARA", "op": "equal", "left": "lv.para.b.fv_fallback", "value": false},
          {"id": "no_fv_fallback_A_PASSA", "op": "equal", "left": "lv.passa.a.fv_fallback", "value": false},
          {"id": "no_fv_fallback_B_PASSA", "op": "equal", "left": "lv.passa.b.fv_fallback", "value": false},
          {"id": "sources_A_PARA_vs_PASSA", "op": "disjoint", "left": "lv.para.a.source_keys", "right": "lv.passa.a.source_keys"},
          {"id": "sources_B_PARA_vs_PASSA", "op": "disjoint", "left": "lv.para.b.source_keys", "right": "lv.passa.b.source_keys"},
          {"id": "support_identity", "op": "same_entity", "left": "lv.support.name", "right": "support.name"},
          {"id": "support_contact", "op": "bbox_intersects", "left": "lv.para.a.bbox", "right": "support.bbox"}
        ]
      }
    }
  },
  "n3": {
    "motor": "ROBOT_LV_N3_N4",
    "variants": ["A_PARA", "B_PARA", "A_PASSA", "B_PASSA", "CORTE_PARA", "CORTE_PASSA"],
    "identity_path": "beam_name",
    "expected_layers": ["NOMENCLATURA", "Painéis"],
    "expected_layers_by_variant": {
      "CORTE_PARA": ["Painéis"],
      "CORTE_PASSA": ["Painéis"]
    },
    "contract_families": {
      "identity": ["beam_name", "side", "behavior", "contract_id", "generation_ready"],
      "geometry": ["structural_segments", "geometry_length", "start_adjustment", "end_adjustment", "total_length"],
      "panels": ["panels[].width", "height1", "height2", "grade_h1", "grade_h2", "panel_type"],
      "events": ["endpoint_events", "structural_segments[].source_key", "structural_segments[].source_slot", "dimension_status"],
      "provenance": ["_sa_meta.schema", "_sa_meta.source", "_sa_meta.behavior_isolated", "_sa_meta.fv_dimension_fallback"]
    },
    "equivalence_strategy": [
      "cada um dos quatro contratos deve apontar para seu próprio source_key",
      "nome Vxxx.A/B deve aparecer no DXF correspondente",
      "soma dos painéis deve reproduzir total_length do contrato",
      "PARA/PASSA iguais só são aceitáveis quando os eventos/ajustes realmente forem iguais",
      "dimensão LV nunca usa ficha FV como fallback"
    ]
  },
  "sample": {"project_id": "dd238e47-1dc6-4f63-a760-4e7ce19a7386", "item": "V328"}
}
