
# Regras de Negócio e Robótica (Performance)


# Ignorar binarios e builds dos robos
_ROBOS_ABAS/**/dist/
_ROBOS_ABAS/**/build/
_ROBOS_ABAS/**/Distribuicao-pyinstaler-secure/
_ROBOS_ABAS/**/*.exe
_ROBOS_ABAS/**/*.rar
_ROBOS_ABAS/**/*.pkg
_ROBOS_ABAS/


ferramentas_LOAD_LISP/

# Arquivos de Design e AutoCAD (Temporários/Backups)
*.dwl
*.dwl2
*.bak
*.dxf
*.dwg
!src/assets/**/*.dwg
!docs/**/*.dwg


# Temporários e Downloads
*.tmp
*.crdownload
*.vision
test_part1.tmp
repository/targets/*.tar.gz


# Logs e Debugs
*.log
debug_output_*.txt
nuitka-crash-report.xml
updater.log

# Versões de Código e Backups
src_raw_backup/
src_obfuscated/
main.py.bak
dist_v1/

# Padrão Python
__pycache__/
*.pyc
venv/
.venv/
build/
dist/
*.egg-info/
releases/

# Binários e Pacotes
*.exe
*.zip
*.msi



# Regras de Agente
.clinerules/byterover-rules.md
.kilocode/rules/byterover-rules.md
.roo/rules/byterover-rules.md
.windsurf/rules/byterover-rules.md
.cursor/rules/byterover-rules.mdc
.kiro/steering/byterover-rules.md
.qoder/rules/byterover-rules.md
.augment/rules/byterover-rules.md
.env

# Portal soberano (docs/HANDOFF-*-PORTAL.md) — nunca versionar segredo nem DB de runtime
portal/.secrets/
portal_data.db
portal_data.db-wal
portal_data.db-shm
portal/logs/

# [2026-07-10] Rodadas repetidas de SA/headless_sa_analise.py (regeneraveis a
# qualquer momento a partir do DXF de entrada — nao sao trabalho perdido se
# nao versionadas) — pasta nomeada <alvo>_<YYYYMMDD>_<HHMMSS>, uma nova a
# cada execucao. Sem isso, cada teste local infla o repo em ~180MB.
DADOS-OBRAS/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]/
scripts/arete/html_fichas/**/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]/

# Scratch de pytest (tmp dirs nomeados na mao via --basetemp/tmp_path em
# testes locais, nao usados por CI)
.pytest-tmp*/

# Cache local regenerável dos fast paths QA (chaveado por conteúdo)
scripts/arete/.cache/

# Estado real do SA fica no portal_data.db (ja ignorado acima) — os JSONs
# soltos na raiz da obra e o cad_project.db sao dumps regeneraveis
DADOS-OBRAS/**/estado_*.json
DADOS-OBRAS/**/cad_project.db
