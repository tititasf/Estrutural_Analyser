{
  "schema": "arete.qa_n1_field_probe/v1",
  "project_id": "dd238e47-1dc6-4f63-a760-4e7ce19a7386",
  "question": "Somente o vínculo declarado P35 face D ↔ V328 tem identidade, dimensão, rastreio e contato geométrico coerentes?",
  "fields": [
    {
      "id": "pillar.face_d.beam_name",
      "class": "PIL",
      "item": "P35",
      "source": "payload",
      "path": "p_sD_v_passa_esq_n.label.0.text",
      "transform": "entity"
    },
    {
      "id": "pillar.face_d.beam_dim",
      "class": "PIL",
      "item": "P35",
      "source": "payload",
      "path": "p_sD_v_passa_esq_d.label.0.text",
      "transform": "dimension"
    },
    {
      "id": "pillar.face_d.link_trace",
      "class": "PIL",
      "item": "P35",
      "source": "payload",
      "path": "p_sD_v_passa_esq_n.label.0",
      "transform": "trace"
    },
    {
      "id": "pillar.bbox",
      "class": "PIL",
      "item": "P35",
      "source": "geometry",
      "path": "",
      "transform": "bbox"
    },
    {
      "id": "beam.name",
      "class": "FV",
      "item": "V328",
      "source": "payload",
      "path": "fields.nome",
      "transform": "entity"
    },
    {
      "id": "beam.dim",
      "class": "FV",
      "item": "V328",
      "source": "payload",
      "path": "fields.dimensao",
      "transform": "dimension"
    },
    {
      "id": "beam.bottom_bbox",
      "class": "FV",
      "item": "V328",
      "source": "payload",
      "path": "links.viga_segs.seg_bottom.0.points",
      "transform": "bbox"
    }
  ],
  "checks": [
    {
      "id": "same_beam_identity",
      "op": "same_entity",
      "left": "pillar.face_d.beam_name",
      "right": "beam.name"
    },
    {
      "id": "same_beam_dimension",
      "op": "dimension_equal",
      "left": "pillar.face_d.beam_dim",
      "right": "beam.dim",
      "order_sensitive": true
    },
    {
      "id": "link_has_trace",
      "op": "equal",
      "left": "pillar.face_d.link_trace",
      "value": true
    },
    {
      "id": "beam_touches_pillar",
      "op": "bbox_intersects",
      "left": "pillar.bbox",
      "right": "beam.bottom_bbox"
    }
  ]
