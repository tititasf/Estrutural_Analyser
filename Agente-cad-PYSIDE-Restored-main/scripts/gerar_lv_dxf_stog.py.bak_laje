DIM_BELOW      = 37     # y = painel_bottom - DIM_BELOW -> cotas paineis individuais
DIM_TOTAL_BELOW= 60     # y = painel_bottom - DIM_TOTAL_BELOW -> cota total
DIM_H_RIGHT    = 28     # x = painel_right + DIM_H_RIGHT -> cota h_lateral vertical
