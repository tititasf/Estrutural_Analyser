[Unit]
Description=CAD Analyzer Consulta Publica API
After=network.target

[Service]
Type=simple
User=cadapp
Group=cadapp
WorkingDirectory=/opt/cad-analyzer
Environment=PUBLIC_CONSULTA_DB_PATH=/opt/cad-analyzer/public_consulta.db
Environment=CONSULTA_PUBLICA_HOST=127.0.0.1
Environment=CONSULTA_PUBLICA_PORT=21390
Environment=CONSULTA_PUBLICA_ALLOWED_ORIGIN=https://cad-analyzer.duckdns.org
Environment=CONSULTA_PUBLICA_AUDIT_LOG=/opt/cad-analyzer/runtime/public_audit.log
ExecStart=/opt/cad-analyzer/.venv/bin/python -m uvicorn consulta-publica-api.main:app --host 127.0.0.1 --port 21390
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
