def lit(buf):
    from PIL import Image
    im = Image.open(io.BytesIO(buf)).convert('RGB')
    a = np.asarray(im)
    L = 0.2126*a[:,:,0] + 0.7152*a[:,:,1] + 0.0722*a[:,:,2]
    return im.size, int((L>=25).sum()), float(L.max()), tuple(a.mean(axis=(0,1)).round().astype(int))

def render(finalize, setlim, bg='#0d0d0d', ax_bg=None):
    fig = plt.figure(figsize=(11, 4.2), dpi=80)
    ax = fig.add_axes([0,0,1,1])
    if ax_bg: ax.set_facecolor(ax_bg)
    Frontend(RenderContext(doc), MatplotlibBackend(ax)).draw_layout(doc.modelspace(), finalize=finalize)
    if setlim == 'auto':
        ax.autoscale_view()
    ax.set_axis_off()
    buf = io.BytesIO()
    fig.savefig(buf, format='png', facecolor=bg)
    plt.close(fig)
    xlim = ax.get_xlim(); ylim = ax.get_ylim()
    return lit(buf.getvalue()), xlim, ylim

